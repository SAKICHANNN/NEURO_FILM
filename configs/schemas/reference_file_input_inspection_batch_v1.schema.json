{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuro-film.local/schemas/reference-file-input-inspection-batch-v1",
  "title": "Neuro-Film Reference File Input Inspection Batch V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "claim_ceiling",
    "inspections"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.reference-file-input-inspection-batch.v1"
    },
    "claim_ceiling": {
      "const": "preflight-only-not-render-authorization"
    },
    "inspections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_id",
          "claim_ceiling",
          "path",
          "file_sha256",
          "accepted",
          "working_space",
          "transfer_state",
          "failure_code"
        ],
        "properties": {
          "schema_id": {
            "const": "neuro-film.reference-file-input-inspection.v1"
          },
          "claim_ceiling": {
            "const": "preflight-only-not-render-authorization"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "file_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "accepted": {
            "type": "boolean"
          },
          "working_space": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "transfer_state": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "failure_code": {
            "oneOf": [
              {
                "enum": [
                  "not-a-file",
                  "decode-or-color-state-rejected",
                  "file-changed-during-inspection",
                  "unsupported-decoded-rail"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "accepted": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "file_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "working_space": {
                  "enum": [
                    "linear_srgb",
                    "linear_rec2020"
                  ]
                },
                "transfer_state": {
                  "const": "display_linear"
                },
                "failure_code": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "failure_code": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  }
}
