{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuro-film.runtime-qualified-shared-staging-decode.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "decode_id",
    "consumption_id",
    "verification_id",
    "run_id",
    "source_count",
    "state",
    "decoded_scope",
    "path_consumption_authorized",
    "persistent_pixels_authorized",
    "delivery_authorized",
    "outputs",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.runtime-qualified-shared-staging-decode.v1"
    },
    "decode_id": {"$ref": "#/$defs/hash"},
    "consumption_id": {"$ref": "#/$defs/hash"},
    "verification_id": {"$ref": "#/$defs/hash"},
    "run_id": {"$ref": "#/$defs/hash"},
    "source_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "state": {
      "const": "decoded-runtime-qualified-shared-staging-samples"
    },
    "decoded_scope": {
      "const": "current-process-readonly-rgb-sample-arrays"
    },
    "path_consumption_authorized": {"const": false},
    "persistent_pixels_authorized": {"const": false},
    "delivery_authorized": {"const": false},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/output"}
    },
    "claim_ceiling": {
      "const": "process-local-decoded-sample-evidence-only-no-path-persistence-or-delivery"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "source_view_id",
        "output_view_id",
        "encoded_file_sha256",
        "encoded_file_size_bytes",
        "output_format",
        "output_bit_depth",
        "width",
        "height",
        "channels",
        "sample_dtype",
        "decoded_pixel_sha256"
      ],
      "properties": {
        "source_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "source_view_id": {"$ref": "#/$defs/hash"},
        "output_view_id": {"$ref": "#/$defs/hash"},
        "encoded_file_sha256": {"$ref": "#/$defs/hash"},
        "encoded_file_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "output_format": {"enum": ["PNG", "JPEG", "TIFF"]},
        "output_bit_depth": {"enum": [8, 16]},
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "channels": {"const": 3},
        "sample_dtype": {"enum": ["uint8", "uint16"]},
        "decoded_pixel_sha256": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {
          "if": {"properties": {"output_bit_depth": {"const": 8}}},
          "then": {"properties": {"sample_dtype": {"const": "uint8"}}}
        },
        {
          "if": {"properties": {"output_bit_depth": {"const": 16}}},
          "then": {"properties": {"sample_dtype": {"const": "uint16"}}}
        },
        {
          "if": {"properties": {"output_format": {"const": "JPEG"}}},
          "then": {"properties": {"output_bit_depth": {"const": 8}}}
        }
      ]
    }
  }
}
