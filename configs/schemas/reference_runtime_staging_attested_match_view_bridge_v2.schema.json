{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuro-film.runtime-staging-attested-match-view-bridge.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "bridge_run_id",
    "attestation_id",
    "attestation_policy_id",
    "decode_id",
    "consumption_id",
    "run_id",
    "bridge_id",
    "profile_id",
    "expected_profile_sha256",
    "source_count",
    "state",
    "path_consumption_authorized",
    "persistent_views_authorized",
    "application_authorized",
    "delivery_authorized",
    "outputs",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.runtime-staging-attested-match-view-bridge.v2"
    },
    "bridge_run_id": {"$ref": "#/$defs/hash"},
    "attestation_id": {"$ref": "#/$defs/hash"},
    "attestation_policy_id": {
      "const": "neuro-film.exact-embedded-srgb-icc-no-conflict.v1"
    },
    "decode_id": {"$ref": "#/$defs/hash"},
    "consumption_id": {"$ref": "#/$defs/hash"},
    "run_id": {"$ref": "#/$defs/hash"},
    "bridge_id": {
      "const": "neuro-film.p72-attested-staging-srgb-eotf-f32.v2"
    },
    "profile_id": {
      "const": "neuro-film.display-relative-linear-srgb-d65.v1"
    },
    "expected_profile_sha256": {
      "const": "217fe48ec958c667f8eef725aa27198f465df95d7662593b90d0a1cc30114356"
    },
    "source_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "state": {
      "const": "prepared-attested-runtime-staging-display-linear-match-views"
    },
    "path_consumption_authorized": {"const": false},
    "persistent_views_authorized": {"const": false},
    "application_authorized": {"const": false},
    "delivery_authorized": {"const": false},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/output"}
    },
    "claim_ceiling": {
      "const": "process-local-metadata-attested-display-linear-match-views-only-no-persistence-application-or-delivery"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "source_view_id",
        "encoded_output_view_id",
        "decoded_pixel_sha256",
        "output_bit_depth",
        "width",
        "height",
        "metadata_attestation_id",
        "profile_binding",
        "profile_sha256",
        "match_view_id",
        "match_view_pixel_sha256",
        "provenance_fingerprint"
      ],
      "properties": {
        "source_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "source_view_id": {"$ref": "#/$defs/hash"},
        "encoded_output_view_id": {"$ref": "#/$defs/hash"},
        "decoded_pixel_sha256": {"$ref": "#/$defs/hash"},
        "output_bit_depth": {"enum": [8, 16]},
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "metadata_attestation_id": {"$ref": "#/$defs/hash"},
        "profile_binding": {
          "enum": [
            "png-iccp-exact-v1",
            "jpeg-app2-icc-exact-v1",
            "tiff-34675-icc-exact-v1"
          ]
        },
        "profile_sha256": {"$ref": "#/$defs/hash"},
        "match_view_id": {"$ref": "#/$defs/hash"},
        "match_view_pixel_sha256": {"$ref": "#/$defs/hash"},
        "provenance_fingerprint": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "profile_binding": {"const": "jpeg-app2-icc-exact-v1"}
            }
          },
          "then": {
            "properties": {
              "output_bit_depth": {"const": 8}
            }
          }
        }
      ]
    }
  }
}
