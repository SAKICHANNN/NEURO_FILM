{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuro-film.runtime-staging-match-view-bridge.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "bridge_run_id",
    "decode_id",
    "consumption_id",
    "run_id",
    "bridge_id",
    "profile_id",
    "source_count",
    "state",
    "path_consumption_authorized",
    "persistent_views_authorized",
    "application_authorized",
    "delivery_authorized",
    "outputs",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.runtime-staging-match-view-bridge.v1"
    },
    "bridge_run_id": {"$ref": "#/$defs/hash"},
    "decode_id": {"$ref": "#/$defs/hash"},
    "consumption_id": {"$ref": "#/$defs/hash"},
    "run_id": {"$ref": "#/$defs/hash"},
    "bridge_id": {
      "const": "neuro-film.p69-decoded-staging-srgb-eotf-f32.v1"
    },
    "profile_id": {
      "const": "neuro-film.display-relative-linear-srgb-d65.v1"
    },
    "source_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "state": {
      "const": "prepared-runtime-staging-display-linear-match-views"
    },
    "path_consumption_authorized": {"const": false},
    "persistent_views_authorized": {"const": false},
    "application_authorized": {"const": false},
    "delivery_authorized": {"const": false},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/output"}
    },
    "claim_ceiling": {
      "const": "process-local-display-linear-match-views-only-no-persistence-application-or-delivery"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "source_view_id",
        "encoded_output_view_id",
        "decoded_pixel_sha256",
        "output_bit_depth",
        "width",
        "height",
        "match_view_id",
        "match_view_pixel_sha256",
        "provenance_fingerprint"
      ],
      "properties": {
        "source_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "source_view_id": {"$ref": "#/$defs/hash"},
        "encoded_output_view_id": {"$ref": "#/$defs/hash"},
        "decoded_pixel_sha256": {"$ref": "#/$defs/hash"},
        "output_bit_depth": {"enum": [8, 16]},
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "match_view_id": {"$ref": "#/$defs/hash"},
        "match_view_pixel_sha256": {"$ref": "#/$defs/hash"},
        "provenance_fingerprint": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
