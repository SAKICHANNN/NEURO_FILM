{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuro-film.local/schemas/reference-core-product-staging-authorization-v1.json",
  "title": "Neuro-Film external-core product staging authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "authorization_id",
    "upstream_batch_id",
    "numeric_guard_batch_id",
    "source_count",
    "state",
    "sources",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.core-product-staging-authorization.v1"
    },
    "authorization_id": {"$ref": "#/$defs/hash"},
    "upstream_batch_id": {"$ref": "#/$defs/hash"},
    "numeric_guard_batch_id": {"$ref": "#/$defs/hash"},
    "source_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "state": {
      "enum": ["authorized-for-staging", "identity-fallback"]
    },
    "sources": {
      "type": "array",
      "minItems": 1, "maxItems": 64,
      "items": {"$ref": "#/$defs/source"}
    },
    "claim_ceiling": {"const": "staging-only-not-committed"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_hash": {
      "oneOf": [
        {"$ref": "#/$defs/hash"},
        {"type": "null"}
      ]
    },
    "nullable_boolean": {
      "oneOf": [
        {"type": "boolean"},
        {"type": "null"}
      ]
    },
    "nullable_string": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "source_view_id",
        "acceptance_decision_id",
        "admission_id",
        "numeric_decision_id",
        "acceptance_accepted_for_product_guard",
        "core_status",
        "promotion_status",
        "research_baseline_override",
        "accepted_for_product_staging",
        "action",
        "reasons"
      ],
      "properties": {
        "source_index": {"type": "integer", "minimum": 0, "maximum": 63},
        "source_view_id": {"$ref": "#/$defs/hash"},
        "acceptance_decision_id": {"$ref": "#/$defs/nullable_hash"},
        "admission_id": {"$ref": "#/$defs/nullable_hash"},
        "numeric_decision_id": {"$ref": "#/$defs/nullable_hash"},
        "acceptance_accepted_for_product_guard": {
          "$ref": "#/$defs/nullable_boolean"
        },
        "core_status": {"$ref": "#/$defs/nullable_string"},
        "promotion_status": {"$ref": "#/$defs/nullable_string"},
        "research_baseline_override": {
          "$ref": "#/$defs/nullable_boolean"
        },
        "accepted_for_product_staging": {
          "$ref": "#/$defs/nullable_boolean"
        },
        "action": {
          "enum": [
            "authorized-for-staging",
            "identity-fallback",
            "not-evaluated"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "enum": [
              "acceptance-not-product-accepted",
              "core-status-not-ok",
              "algorithm-not-promoted",
              "research-baseline-override",
              "upstream-numeric-fallback"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
