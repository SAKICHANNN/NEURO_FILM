{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuro-film.local/schemas/reference-dpct-invocation-compatibility-lock-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "compatibility_profile_id", "producer", "package", "runtime", "wire", "rights", "claim_ceiling"],
  "properties": {
    "schema_id": {"const": "neuro-film.dpct-invocation-compatibility-lock.v1"},
    "compatibility_profile_id": {"const": "neuro-film.dpct-invocation-consumer.v1"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "stable_commit", "package_source_commit", "fixture_commit", "package_lock_sha256"],
      "properties": {
        "repository_id": {"const": "zhuise-dpct"},
        "stable_commit": {
          "const": "e22725d8524ed6ba56f37180abc400213908c6f4"
        },
        "package_source_commit": {"const": "01ef0616610b16246623236301234ff3b4c4a7f2"},
        "fixture_commit": {"const": "eb4b889bc18f1aba078e19e7e62fbf8c4add6e54"},
        "package_lock_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "version", "entrypoint", "wheel_filename", "wheel_size_bytes", "wheel_sha256"],
      "properties": {
        "distribution": {"const": "zhuise-research"},
        "version": {"const": "0.2.0"},
        "entrypoint": {"const": "zhuise-producer-invoke"},
        "wheel_filename": {"const": "zhuise_research-0.2.0-py3-none-any.whl"},
        "wheel_size_bytes": {"const": 95994},
        "wheel_sha256": {"const": "fd995ad88c9f30f2136508f7c3879ce6768fde7ff2e149537d2b58f78e36c292"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_major_minor", "numpy", "pillow"],
      "properties": {
        "python_major_minor": {"const": "3.12"},
        "numpy": {"const": "2.4.4"},
        "pillow": {"const": "12.1.1"}
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_schema", "request_schema_sha256", "response_schema", "response_schema_sha256", "fixture_sha256", "capability_id", "profile_id", "lower_compatibility_profile_id"],
      "properties": {
        "request_schema": {"const": "zhuise.invocation-request.v1"},
        "request_schema_sha256": {"$ref": "#/$defs/hash"},
        "response_schema": {"const": "zhuise.invocation-response.v1"},
        "response_schema_sha256": {"$ref": "#/$defs/hash"},
        "fixture_sha256": {"$ref": "#/$defs/hash"},
        "capability_id": {"const": "zhuise.dpct-chroma.cpu-reference.v1"},
        "profile_id": {"const": "zhuise.display-linear-srgb-d65-relative-f32.v1"},
        "lower_compatibility_profile_id": {"const": "neuro-film.dpct-consumer.v2"}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "redistribution", "reason"],
      "properties": {
        "scope": {"const": "local-research-integration-only"},
        "redistribution": {"const": false},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "claim_ceiling": {"const": "candidate-only-not-promoted-not-applied-not-delivered"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
