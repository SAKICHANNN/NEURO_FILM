{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuro-film.local/schemas/reference_external_core_staging_verification_v1.schema.json",
  "title": "Neuro-Film External Core Staging Verification V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "verification_id",
    "run_id",
    "report_path",
    "report_file_sha256",
    "authorization_id",
    "reference_intent_id",
    "source_count",
    "state",
    "outputs",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.external-core-staging-verification.v1"
    },
    "verification_id": {
      "$ref": "#/$defs/hash"
    },
    "run_id": {
      "$ref": "#/$defs/hash"
    },
    "report_path": {
      "type": "string",
      "minLength": 1
    },
    "report_file_sha256": {
      "$ref": "#/$defs/hash"
    },
    "authorization_id": {
      "$ref": "#/$defs/hash"
    },
    "reference_intent_id": {
      "$ref": "#/$defs/hash"
    },
    "source_count": {
      "type": "integer",
      "minimum": 1, "maximum": 64
    },
    "state": {
      "const": "verified-staging"
    },
    "outputs": {
      "type": "array",
      "minItems": 1, "maxItems": 64,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "claim_ceiling": {
      "const": "verified-staging-not-delivered"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "apply_receipt_id",
        "output_path",
        "output_file_sha256"
      ],
      "properties": {
        "source_index": {
          "type": "integer",
          "minimum": 0, "maximum": 63
        },
        "apply_receipt_id": {
          "$ref": "#/$defs/hash"
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "output_file_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
