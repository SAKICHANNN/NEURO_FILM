{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuro-film.external-shared-staging-verification.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "verification_id",
    "run_id",
    "report_path",
    "report_file_sha256",
    "authorization_id",
    "numeric_guard_batch_id",
    "operator_id",
    "reference_view_id",
    "source_count",
    "state",
    "outputs",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.external-shared-staging-verification.v1"
    },
    "verification_id": {"$ref": "#/$defs/hash"},
    "run_id": {"$ref": "#/$defs/hash"},
    "report_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?i)\\.json$"
    },
    "report_file_sha256": {"$ref": "#/$defs/hash"},
    "authorization_id": {"$ref": "#/$defs/hash"},
    "numeric_guard_batch_id": {"$ref": "#/$defs/hash"},
    "operator_id": {"$ref": "#/$defs/hash"},
    "reference_view_id": {"$ref": "#/$defs/hash"},
    "source_count": {"type": "integer", "minimum": 1},
    "state": {"const": "verified-shared-staging"},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/output"}
    },
    "claim_ceiling": {
      "const": "verified-shared-staging-not-delivered"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "apply_receipt_id",
        "producer_apply_result_id",
        "output_path",
        "output_file_sha256"
      ],
      "properties": {
        "source_index": {"type": "integer", "minimum": 0},
        "apply_receipt_id": {"$ref": "#/$defs/hash"},
        "producer_apply_result_id": {"$ref": "#/$defs/producer_hash"},
        "output_path": {"type": "string", "minLength": 1},
        "output_file_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
