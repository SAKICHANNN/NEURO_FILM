{
  "$id": "neuro-film.reference-match-successor-runtime-evidence.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability_id": {
      "$ref": "#/$defs/nonempty"
    },
    "claim_ceiling": {
      "const": "runtime-evidence-only-no-algorithm-promotion"
    },
    "declaration_id": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_id": {
      "$ref": "#/$defs/sha256"
    },
    "policy_id": {
      "const": "neuro-film.reference-match-successor-runtime-evidence-policy.v1"
    },
    "producer_commit": {
      "$ref": "#/$defs/commit"
    },
    "profile_id": {
      "$ref": "#/$defs/nonempty"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/runtime_record"
      },
      "maxItems": 4,
      "minItems": 1,
      "type": "array"
    },
    "schema_id": {
      "const": "neuro-film.reference-match-successor-runtime-evidence.v1"
    }
  },
  "required": [
    "capability_id",
    "claim_ceiling",
    "declaration_id",
    "evidence_id",
    "policy_id",
    "producer_commit",
    "profile_id",
    "records",
    "schema_id"
  ],
  "title": "Neuro-Film Successor Runtime Evidence V1",
  "type": "object",
  "$defs": {
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "nonempty": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "runtime_record": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "$ref": "#/$defs/nonempty"
        },
        "backend_id": {
          "$ref": "#/$defs/nonempty"
        },
        "backend_version": {
          "$ref": "#/$defs/nonempty"
        },
        "conformance_passed": {
          "type": "boolean"
        },
        "deterministic_replay_passed": {
          "type": "boolean"
        },
        "environment_count": {
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "environment_matrix_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "environment_summary": {
          "$ref": "#/$defs/nonempty"
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "failure_injection_passed": {
          "type": "boolean"
        },
        "os_name": {
          "$ref": "#/$defs/nonempty"
        },
        "os_version": {
          "$ref": "#/$defs/nonempty"
        },
        "proof_class": {
          "enum": [
            "host-runtime",
            "device-runtime",
            "cross-compiled",
            "link-only",
            "object-only"
          ]
        },
        "record_id": {
          "$ref": "#/$defs/sha256"
        },
        "replay_count": {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runner_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_runtime": {
          "enum": [
            "windows_x64",
            "macos_arm64",
            "ios_arm64",
            "android_arm64"
          ]
        }
      },
      "required": [
        "architecture",
        "backend_id",
        "backend_version",
        "conformance_passed",
        "deterministic_replay_passed",
        "environment_count",
        "environment_matrix_sha256",
        "environment_summary",
        "executable_sha256",
        "failure_injection_passed",
        "os_name",
        "os_version",
        "proof_class",
        "record_id",
        "replay_count",
        "report_sha256",
        "runner_sha256",
        "target_runtime"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
