{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmcfm.local/schemas/render_recipe_v3.schema.json",
  "title": "K-MCFM deterministic replay recipe v3 with explicit PNG16 compression",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "profile", "assets", "input", "render", "output", "claim", "software"],
  "properties": {
    "schema_id": {"const": "kmcfm.render-recipe.v3"},
    "profile": {"$ref": "render_recipe_v2.schema.json#/properties/profile"},
    "assets": {"$ref": "render_recipe_v2.schema.json#/properties/assets"},
    "input": {"$ref": "render_recipe_v2.schema.json#/properties/input"},
    "render": {"$ref": "render_recipe_v2.schema.json#/properties/render"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format", "bit_depth", "transfer", "icc_profile_fingerprint_sha256", "png_compression"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "render_recipe_v2.schema.json#/$defs/sha256"},
        "format": {"const": "PNG"},
        "bit_depth": {"const": 16},
        "transfer": {"const": "sRGB"},
        "icc_profile_fingerprint_sha256": {"$ref": "render_recipe_v2.schema.json#/$defs/sha256"},
        "png_compression": {"type": "integer", "minimum": 0, "maximum": 9}
      }
    },
    "claim": {"$ref": "render_recipe_v2.schema.json#/properties/claim"},
    "software": {"$ref": "render_recipe_v2.schema.json#/properties/software"}
  }
}
