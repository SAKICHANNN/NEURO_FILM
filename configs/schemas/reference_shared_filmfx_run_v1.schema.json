{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuro-film.shared-filmfx-run.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "run_id",
    "composition_plan_id",
    "staging_verification_id",
    "staging_run_id",
    "authorization_id",
    "numeric_guard_batch_id",
    "operator_id",
    "source_count",
    "seed",
    "state",
    "outputs",
    "report_path",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {"const": "neuro-film.shared-filmfx-run.v1"},
    "run_id": {"$ref": "#/$defs/hash"},
    "composition_plan_id": {"$ref": "#/$defs/hash"},
    "staging_verification_id": {"$ref": "#/$defs/hash"},
    "staging_run_id": {"$ref": "#/$defs/hash"},
    "authorization_id": {"$ref": "#/$defs/hash"},
    "numeric_guard_batch_id": {"$ref": "#/$defs/hash"},
    "operator_id": {"$ref": "#/$defs/hash"},
    "source_count": {"type": "integer", "minimum": 1},
    "seed": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "state": {"const": "shared-filmfx-rendered-to-staging"},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/output"}
    },
    "report_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "(?i)\\.json$"
    },
    "claim_ceiling": {"const": "shared-filmfx-staging-not-delivered"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "apply_receipt_id",
        "producer_apply_result_id",
        "input_path",
        "input_file_sha256",
        "output_path",
        "output_file_sha256",
        "output_format",
        "output_bit_depth",
        "grain_seed",
        "dust_seed"
      ],
      "properties": {
        "source_index": {"type": "integer", "minimum": 0},
        "apply_receipt_id": {"$ref": "#/$defs/hash"},
        "producer_apply_result_id": {"$ref": "#/$defs/producer_hash"},
        "input_path": {"type": "string", "minLength": 1},
        "input_file_sha256": {"$ref": "#/$defs/hash"},
        "output_path": {"type": "string", "minLength": 1},
        "output_file_sha256": {"$ref": "#/$defs/hash"},
        "output_format": {"enum": ["PNG", "JPEG", "TIFF"]},
        "output_bit_depth": {"enum": [8, 16]},
        "grain_seed": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "dust_seed": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      }
    }
  }
}
