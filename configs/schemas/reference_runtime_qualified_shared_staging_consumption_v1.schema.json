{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuro-film.runtime-qualified-shared-staging-consumption.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "consumption_id",
    "verification_id",
    "run_id",
    "runtime_qualification_id",
    "handle_policy_id",
    "handle_identity_scheme",
    "source_count",
    "state",
    "snapshot_scope",
    "path_consumption_authorized",
    "persistent_snapshot_authorized",
    "delivery_authorized",
    "outputs",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.runtime-qualified-shared-staging-consumption.v1"
    },
    "consumption_id": {"$ref": "#/$defs/hash"},
    "verification_id": {"$ref": "#/$defs/hash"},
    "run_id": {"$ref": "#/$defs/hash"},
    "runtime_qualification_id": {"$ref": "#/$defs/hash"},
    "handle_policy_id": {
      "const": "neuro-film.single-open-double-read-final-rehash.v1"
    },
    "handle_identity_scheme": {
      "enum": [
        "windows-volume-file-id.v1",
        "posix-device-inode.v1"
      ]
    },
    "source_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "state": {
      "const": "captured-runtime-qualified-shared-staging-bytes"
    },
    "snapshot_scope": {
      "const": "current-process-immutable-bytes-from-one-handle-session"
    },
    "path_consumption_authorized": {"const": false},
    "persistent_snapshot_authorized": {"const": false},
    "delivery_authorized": {"const": false},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/output"}
    },
    "claim_ceiling": {
      "const": "process-local-immutable-byte-snapshot-only-no-path-reopen-persistence-or-delivery"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "source_view_id",
        "output_view_id",
        "output_file_sha256",
        "output_file_size_bytes",
        "handle_identity_id"
      ],
      "properties": {
        "source_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "source_view_id": {"$ref": "#/$defs/hash"},
        "output_view_id": {"$ref": "#/$defs/hash"},
        "output_file_sha256": {"$ref": "#/$defs/hash"},
        "output_file_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "handle_identity_id": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
