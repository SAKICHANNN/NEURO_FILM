{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuro-film.shared-numeric-batch-guard.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "guard_batch_id",
    "upstream_batch_id",
    "operator_id",
    "policy",
    "policy_id",
    "source_count",
    "atomic_state",
    "decisions",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {"const": "neuro-film.shared-numeric-batch-guard.v1"},
    "guard_batch_id": {"$ref": "#/$defs/hash"},
    "upstream_batch_id": {"$ref": "#/$defs/hash"},
    "operator_id": {"$ref": "#/$defs/hash"},
    "policy": {"$ref": "#/$defs/policy"},
    "policy_id": {"$ref": "#/$defs/hash"},
    "source_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "atomic_state": {
      "enum": ["eligible-for-transaction", "identity-fallback"]
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/decision"}
    },
    "claim_ceiling": {"const": "numeric-only-no-visual-claim"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "max_out_of_gamut_fraction",
        "max_clipping_fraction",
        "max_projected_fraction",
        "max_new_boundary_fraction",
        "boundary_epsilon"
      ],
      "properties": {
        "schema_id": {"const": "neuro-film.core-numeric-guard-policy.v1"},
        "max_out_of_gamut_fraction": {"$ref": "#/$defs/fraction"},
        "max_clipping_fraction": {"$ref": "#/$defs/fraction"},
        "max_projected_fraction": {"$ref": "#/$defs/fraction"},
        "max_new_boundary_fraction": {"$ref": "#/$defs/fraction"},
        "boundary_epsilon": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 0.5
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "facts_id",
        "receipt_id",
        "producer_diagnostics_id",
        "all_finite",
        "output_minimum",
        "output_maximum",
        "out_of_gamut_fraction",
        "clipping_fraction",
        "projected_fraction"
      ],
      "properties": {
        "schema_id": {"const": "neuro-film.shared-apply-numeric-facts.v1"},
        "facts_id": {"$ref": "#/$defs/hash"},
        "receipt_id": {"$ref": "#/$defs/hash"},
        "producer_diagnostics_id": {"$ref": "#/$defs/producer_hash"},
        "all_finite": {"const": true},
        "output_minimum": {"type": "number"},
        "output_maximum": {"type": "number"},
        "out_of_gamut_fraction": {"$ref": "#/$defs/fraction"},
        "clipping_fraction": {"$ref": "#/$defs/fraction"},
        "projected_fraction": {"$ref": "#/$defs/fraction"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "decision_id",
        "upstream_batch_id",
        "operator_id",
        "policy_id",
        "source_index",
        "source_view_id",
        "receipt_id",
        "output_view_id",
        "facts",
        "accepted_for_transaction",
        "action",
        "reasons",
        "new_boundary_fraction"
      ],
      "properties": {
        "schema_id": {
          "const": "neuro-film.shared-apply-numeric-decision.v1"
        },
        "decision_id": {"$ref": "#/$defs/hash"},
        "upstream_batch_id": {"$ref": "#/$defs/hash"},
        "operator_id": {"$ref": "#/$defs/hash"},
        "policy_id": {"$ref": "#/$defs/hash"},
        "source_index": {"type": "integer", "minimum": 0, "maximum": 63},
        "source_view_id": {"$ref": "#/$defs/hash"},
        "receipt_id": {"$ref": "#/$defs/hash"},
        "output_view_id": {"$ref": "#/$defs/hash"},
        "facts": {"$ref": "#/$defs/facts"},
        "accepted_for_transaction": {"type": "boolean"},
        "action": {
          "enum": ["eligible-for-transaction", "identity-fallback"]
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "out-of-gamut-fraction",
              "clipping-fraction",
              "projected-fraction",
              "new-boundary-fraction"
            ]
          }
        },
        "new_boundary_fraction": {"$ref": "#/$defs/fraction"}
      }
    }
  }
}
