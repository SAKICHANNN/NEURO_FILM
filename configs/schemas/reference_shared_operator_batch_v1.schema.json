{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuro-film.reference-shared-batch.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "batch_id",
    "policy_id",
    "claim_ceiling",
    "operator",
    "source_count",
    "sources"
  ],
  "properties": {
    "schema_id": {"const": "neuro-film.reference-shared-batch.v1"},
    "batch_id": {"$ref": "#/$defs/hash"},
    "policy_id": {
      "const": "neuro-film.reference-only-shared-batch.v1"
    },
    "claim_ceiling": {
      "const": "candidate-only-awaiting-a1-a4-a5-and-numeric-product-guards"
    },
    "operator": {"$ref": "#/$defs/operator"},
    "source_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/receipt"}
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "operator_id",
        "fit_semantics",
        "batch_transform_policy",
        "compatibility_profile_id",
        "capability_id",
        "producer_commit",
        "producer_bundle_id",
        "reference_view_id",
        "producer_reference_view_id",
        "profile_id",
        "model_fingerprint",
        "options_sha256"
      ],
      "properties": {
        "schema_id": {
          "const": "neuro-film.reference-shared-operator.v1"
        },
        "operator_id": {"$ref": "#/$defs/hash"},
        "fit_semantics": {"const": "reference-only-shared"},
        "batch_transform_policy": {"const": "shared-bundle"},
        "compatibility_profile_id": {"$ref": "#/$defs/text"},
        "capability_id": {"$ref": "#/$defs/text"},
        "producer_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "producer_bundle_id": {"$ref": "#/$defs/producer_hash"},
        "reference_view_id": {"$ref": "#/$defs/hash"},
        "producer_reference_view_id": {
          "$ref": "#/$defs/producer_hash"
        },
        "profile_id": {"$ref": "#/$defs/text"},
        "model_fingerprint": {"$ref": "#/$defs/hash"},
        "options_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "receipt_id",
        "claim_ceiling",
        "operator_id",
        "source_index",
        "source_view_id",
        "producer_source_view_id",
        "producer_apply_result_id",
        "diagnostics_id",
        "output_view"
      ],
      "properties": {
        "schema_id": {
          "const": "neuro-film.reference-shared-apply-receipt.v1"
        },
        "receipt_id": {"$ref": "#/$defs/hash"},
        "claim_ceiling": {
          "const": "candidate-only-awaiting-a1-a4-a5-and-numeric-product-guards"
        },
        "operator_id": {"$ref": "#/$defs/hash"},
        "source_index": {"type": "integer", "minimum": 0},
        "source_view_id": {"$ref": "#/$defs/hash"},
        "producer_source_view_id": {"$ref": "#/$defs/producer_hash"},
        "producer_apply_result_id": {"$ref": "#/$defs/producer_hash"},
        "diagnostics_id": {"$ref": "#/$defs/producer_hash"},
        "output_view": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_id",
            "view_id",
            "profile_id",
            "pixel_sha256",
            "shape",
            "strides_bytes",
            "channel_layout",
            "alpha_mode",
            "domain",
            "primaries",
            "white_point",
            "transfer",
            "range",
            "reference_white_nits",
            "render_bridge_id",
            "provenance_fingerprint"
          ],
          "properties": {
            "schema_id": {
              "const": "neuro-film.reference-core-match-view.v1"
            },
            "view_id": {"$ref": "#/$defs/hash"},
            "profile_id": {
              "enum": [
                "neuro-film.display-relative-linear-srgb-d65.v1",
                "neuro-film.display-relative-linear-rec2020-d65.v1",
                "scene-relative-linear-acescg-d60.v1",
                "display-absolute-linear-xyz-d65.v1"
              ]
            },
            "pixel_sha256": {"$ref": "#/$defs/hash"},
            "shape": {
              "type": "array",
              "prefixItems": [
                {"type": "integer", "minimum": 1},
                {"type": "integer", "minimum": 1},
                {"const": 3}
              ],
              "minItems": 3,
              "maxItems": 3
            },
            "strides_bytes": {
              "type": "array",
              "items": {"type": "integer", "minimum": 4},
              "minItems": 3,
              "maxItems": 3
            },
            "channel_layout": {"const": "rgb"},
            "alpha_mode": {"const": "absent"},
            "domain": {
              "enum": [
                "display-relative-linear",
                "display-absolute-linear",
                "scene-relative-linear"
              ]
            },
            "primaries": {
              "enum": ["srgb-rec709", "rec2020", "aces-ap1", "xyz"]
            },
            "white_point": {"enum": ["D60", "D65"]},
            "transfer": {"const": "linear"},
            "range": {"const": "extended-float"},
            "reference_white_nits": {
              "anyOf": [
                {"type": "number", "exclusiveMinimum": 0},
                {"type": "null"}
              ]
            },
            "render_bridge_id": {
              "const": "neuro-film.shared-operator-output.v1"
            },
            "provenance_fingerprint": {"$ref": "#/$defs/hash"}
          }
        }
      }
    }
  }
}
