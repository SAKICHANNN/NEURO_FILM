{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuro-film.local/schemas/reference-core-numeric-batch-guard-v1.json",
  "title": "Neuro-Film external-core atomic numeric batch guard v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "guard_batch_id",
    "upstream_batch_id",
    "upstream_atomic_state",
    "numeric_policy_id",
    "source_count",
    "atomic_state",
    "sources",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.core-numeric-batch-guard.v1"
    },
    "guard_batch_id": {"$ref": "#/$defs/hash"},
    "upstream_batch_id": {"$ref": "#/$defs/hash"},
    "upstream_atomic_state": {
      "enum": ["pending-product-guard", "identity-fallback"]
    },
    "numeric_policy_id": {"$ref": "#/$defs/nullable_hash"},
    "source_count": {"type": "integer", "minimum": 1},
    "atomic_state": {
      "enum": ["eligible-for-transaction", "identity-fallback"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "claim_ceiling": {"const": "numeric-only-no-visual-claim"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_hash": {
      "oneOf": [
        {"$ref": "#/$defs/hash"},
        {"type": "null"}
      ]
    },
    "nullable_boolean": {
      "oneOf": [
        {"type": "boolean"},
        {"type": "null"}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "source_view_id",
        "apply_receipt_id",
        "admission_id",
        "numeric_decision_id",
        "numeric_accepted_for_transaction",
        "individual_action"
      ],
      "properties": {
        "source_index": {"type": "integer", "minimum": 0},
        "source_view_id": {"$ref": "#/$defs/hash"},
        "apply_receipt_id": {"$ref": "#/$defs/nullable_hash"},
        "admission_id": {"$ref": "#/$defs/nullable_hash"},
        "numeric_decision_id": {"$ref": "#/$defs/nullable_hash"},
        "numeric_accepted_for_transaction": {
          "$ref": "#/$defs/nullable_boolean"
        },
        "individual_action": {
          "enum": [
            "eligible-for-transaction",
            "identity-fallback",
            "not-evaluated"
          ]
        }
      }
    }
  }
}
