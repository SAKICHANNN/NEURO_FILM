{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuro-film.local/schemas/reference-core-numeric-guard-decision-v1.json",
  "title": "Neuro-Film external-core numeric guard decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "decision_id",
    "policy",
    "policy_id",
    "admission_id",
    "receipt_id",
    "source_view_id",
    "output_view_id",
    "admission_accepted_for_product_guard",
    "accepted_for_transaction",
    "action",
    "reasons",
    "out_of_gamut_fraction",
    "clipping_fraction",
    "projected_fraction",
    "new_boundary_fraction",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.core-numeric-guard-decision.v1"
    },
    "decision_id": {"$ref": "#/$defs/hash"},
    "policy": {"$ref": "#/$defs/policy"},
    "policy_id": {"$ref": "#/$defs/hash"},
    "admission_id": {"$ref": "#/$defs/hash"},
    "receipt_id": {"$ref": "#/$defs/hash"},
    "source_view_id": {"$ref": "#/$defs/hash"},
    "output_view_id": {"$ref": "#/$defs/hash"},
    "admission_accepted_for_product_guard": {"type": "boolean"},
    "accepted_for_transaction": {"type": "boolean"},
    "action": {
      "enum": ["eligible-for-transaction", "identity-fallback"]
    },
    "reasons": {
      "type": "array",
      "items": {
        "enum": [
          "admission-identity-fallback",
          "out-of-gamut-fraction",
          "clipping-fraction",
          "projected-fraction",
          "new-boundary-fraction"
        ]
      },
      "uniqueItems": true
    },
    "out_of_gamut_fraction": {"$ref": "#/$defs/fraction"},
    "clipping_fraction": {"$ref": "#/$defs/fraction"},
    "projected_fraction": {"$ref": "#/$defs/fraction"},
    "new_boundary_fraction": {"$ref": "#/$defs/fraction"},
    "claim_ceiling": {"const": "numeric-only-no-visual-claim"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "max_out_of_gamut_fraction",
        "max_clipping_fraction",
        "max_projected_fraction",
        "max_new_boundary_fraction",
        "boundary_epsilon"
      ],
      "properties": {
        "schema_id": {
          "const": "neuro-film.core-numeric-guard-policy.v1"
        },
        "max_out_of_gamut_fraction": {"$ref": "#/$defs/fraction"},
        "max_clipping_fraction": {"$ref": "#/$defs/fraction"},
        "max_projected_fraction": {"$ref": "#/$defs/fraction"},
        "max_new_boundary_fraction": {"$ref": "#/$defs/fraction"},
        "boundary_epsilon": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 0.5
        }
      }
    }
  }
}
