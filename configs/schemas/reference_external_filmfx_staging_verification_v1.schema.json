{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuro-film.local/schemas/reference_external_filmfx_staging_verification_v1.schema.json",
  "title": "Neuro-Film External FilmFX Staging Verification V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "verification_id",
    "run_id",
    "report_path",
    "report_file_sha256",
    "composition_plan_id",
    "staging_verification_id",
    "source_count",
    "seed",
    "state",
    "outputs",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.external-filmfx-staging-verification.v1"
    },
    "verification_id": {
      "$ref": "#/$defs/hash"
    },
    "run_id": {
      "$ref": "#/$defs/hash"
    },
    "report_path": {
      "type": "string",
      "minLength": 1
    },
    "report_file_sha256": {
      "$ref": "#/$defs/hash"
    },
    "composition_plan_id": {
      "$ref": "#/$defs/hash"
    },
    "staging_verification_id": {
      "$ref": "#/$defs/hash"
    },
    "source_count": {
      "type": "integer",
      "minimum": 1, "maximum": 64
    },
    "seed": {
      "$ref": "#/$defs/seed"
    },
    "state": {
      "const": "verified-filmfx-staging"
    },
    "outputs": {
      "type": "array",
      "minItems": 1, "maxItems": 64,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "claim_ceiling": {
      "const": "verified-filmfx-staging-not-delivered"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "input_path",
        "input_file_sha256",
        "output_path",
        "output_file_sha256",
        "output_format",
        "output_bit_depth",
        "grain_seed",
        "dust_seed"
      ],
      "properties": {
        "source_index": {
          "type": "integer",
          "minimum": 0, "maximum": 63
        },
        "input_path": {
          "type": "string",
          "minLength": 1
        },
        "input_file_sha256": {
          "$ref": "#/$defs/hash"
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "output_file_sha256": {
          "$ref": "#/$defs/hash"
        },
        "output_format": {
          "enum": [
            "PNG",
            "JPEG",
            "TIFF"
          ]
        },
        "output_bit_depth": {
          "enum": [
            8,
            16
          ]
        },
        "grain_seed": {
          "$ref": "#/$defs/seed"
        },
        "dust_seed": {
          "$ref": "#/$defs/seed"
        }
      }
    }
  }
}
