{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuro-film.reference-shared-product-staging-authorization.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "authorization_id",
    "batch_id",
    "numeric_guard_batch_id",
    "operator_id",
    "declaration_id",
    "successor_declaration_json",
    "promotion_binding",
    "admission_evaluation_ready",
    "admission_product_ready",
    "admission_evaluation_reasons",
    "admission_product_reasons",
    "source_count",
    "state",
    "sources",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.reference-shared-product-staging-authorization.v1"
    },
    "authorization_id": {"$ref": "#/$defs/hash"},
    "batch_id": {"$ref": "#/$defs/hash"},
    "numeric_guard_batch_id": {"$ref": "#/$defs/hash"},
    "operator_id": {"$ref": "#/$defs/hash"},
    "declaration_id": {"$ref": "#/$defs/hash"},
    "successor_declaration_json": {
      "type": "string",
      "minLength": 2
    },
    "promotion_binding": {"$ref": "#/$defs/promotion_binding"},
    "admission_evaluation_ready": {"type": "boolean"},
    "admission_product_ready": {"type": "boolean"},
    "admission_evaluation_reasons": {"$ref": "#/$defs/reasons"},
    "admission_product_reasons": {"$ref": "#/$defs/reasons"},
    "source_count": {"type": "integer", "minimum": 1},
    "state": {
      "enum": ["authorized-for-staging", "identity-fallback"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "claim_ceiling": {"const": "staging-only-not-committed"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "promotion_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "binding_id",
        "declaration_id",
        "stable_evidence_id",
        "gate_policy_id",
        "capability_id",
        "producer_commit",
        "model_fingerprint",
        "options_sha256",
        "promotion_status",
        "promotion_reasons",
        "claim_ceiling"
      ],
      "properties": {
        "schema_id": {
          "const": "neuro-film.reference-shared-promotion-binding.v1"
        },
        "binding_id": {"$ref": "#/$defs/hash"},
        "declaration_id": {"$ref": "#/$defs/hash"},
        "stable_evidence_id": {"$ref": "#/$defs/hash"},
        "gate_policy_id": {
          "const": "neuro-film.reference-match-p44-gates.v1"
        },
        "capability_id": {"$ref": "#/$defs/text"},
        "producer_commit": {"$ref": "#/$defs/commit"},
        "model_fingerprint": {"$ref": "#/$defs/hash"},
        "options_sha256": {"$ref": "#/$defs/hash"},
        "promotion_status": {
          "enum": [
            "rejected",
            "eligible-for-visual-review",
            "promoted"
          ]
        },
        "promotion_reasons": {"$ref": "#/$defs/reasons"},
        "claim_ceiling": {
          "const": "evidence-binding-only-no-authorization"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "source_view_id",
        "receipt_id",
        "numeric_decision_id",
        "numeric_accepted_for_transaction",
        "action",
        "reasons"
      ],
      "properties": {
        "source_index": {"type": "integer", "minimum": 0},
        "source_view_id": {"$ref": "#/$defs/hash"},
        "receipt_id": {"$ref": "#/$defs/hash"},
        "numeric_decision_id": {"$ref": "#/$defs/hash"},
        "numeric_accepted_for_transaction": {"type": "boolean"},
        "action": {
          "enum": ["authorized-for-staging", "identity-fallback"]
        },
        "reasons": {"$ref": "#/$defs/reasons"}
      }
    }
  }
}
