{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuro-film.runtime-qualified-shared-staging-run.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "run_id",
    "runtime_qualification_id",
    "runtime_evidence_id",
    "declaration_id",
    "authorization_id",
    "upstream_batch_id",
    "numeric_guard_batch_id",
    "operator_id",
    "reference_view_id",
    "source_count",
    "state",
    "outputs",
    "report_path",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.runtime-qualified-shared-staging-run.v1"
    },
    "run_id": {"$ref": "#/$defs/hash"},
    "runtime_qualification_id": {"$ref": "#/$defs/hash"},
    "runtime_evidence_id": {"$ref": "#/$defs/hash"},
    "declaration_id": {"$ref": "#/$defs/hash"},
    "authorization_id": {"$ref": "#/$defs/hash"},
    "upstream_batch_id": {"$ref": "#/$defs/hash"},
    "numeric_guard_batch_id": {"$ref": "#/$defs/hash"},
    "operator_id": {"$ref": "#/$defs/hash"},
    "reference_view_id": {"$ref": "#/$defs/hash"},
    "source_count": {"type": "integer", "minimum": 1},
    "state": {
      "const": "committed-to-runtime-qualified-shared-staging"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/output"}
    },
    "report_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\.[jJ][sS][oO][nN]$"
    },
    "claim_ceiling": {
      "const": "runtime-qualified-shared-staging-files-committed-not-delivered"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "source_view_id",
        "apply_receipt_id",
        "producer_apply_result_id",
        "diagnostics_id",
        "output_view_id",
        "output_path",
        "output_file_sha256",
        "output_format",
        "output_bit_depth",
        "encode_clipped_fraction"
      ],
      "properties": {
        "source_index": {"type": "integer", "minimum": 0},
        "source_view_id": {"$ref": "#/$defs/hash"},
        "apply_receipt_id": {"$ref": "#/$defs/hash"},
        "producer_apply_result_id": {"$ref": "#/$defs/producer_hash"},
        "diagnostics_id": {"$ref": "#/$defs/producer_hash"},
        "output_view_id": {"$ref": "#/$defs/hash"},
        "output_path": {"type": "string", "minLength": 1},
        "output_file_sha256": {"$ref": "#/$defs/hash"},
        "output_format": {"enum": ["PNG", "JPEG", "TIFF"]},
        "output_bit_depth": {"enum": [8, 16]},
        "encode_clipped_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
