{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuro-film.local/schemas/reference_external_core_staging_run_v1.schema.json",
  "title": "Neuro-Film External Core Staging Run V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "run_id",
    "authorization_id",
    "upstream_batch_id",
    "reference_intent_id",
    "source_count",
    "state",
    "outputs",
    "report_path",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.external-core-staging-run.v1"
    },
    "run_id": {
      "$ref": "#/$defs/hash"
    },
    "authorization_id": {
      "$ref": "#/$defs/hash"
    },
    "upstream_batch_id": {
      "$ref": "#/$defs/hash"
    },
    "reference_intent_id": {
      "$ref": "#/$defs/hash"
    },
    "source_count": {
      "type": "integer",
      "minimum": 1, "maximum": 64
    },
    "state": {
      "const": "committed-to-staging"
    },
    "outputs": {
      "type": "array",
      "minItems": 1, "maxItems": 64,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "report_path": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "const": "staging-files-committed-not-delivered"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "source_view_id",
        "transform_id",
        "apply_receipt_id",
        "output_view_id",
        "output_path",
        "output_file_sha256",
        "output_format",
        "output_bit_depth",
        "encode_clipped_fraction"
      ],
      "properties": {
        "source_index": {
          "type": "integer",
          "minimum": 0, "maximum": 63
        },
        "source_view_id": {
          "$ref": "#/$defs/hash"
        },
        "transform_id": {
          "$ref": "#/$defs/hash"
        },
        "apply_receipt_id": {
          "$ref": "#/$defs/hash"
        },
        "output_view_id": {
          "$ref": "#/$defs/hash"
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "output_file_sha256": {
          "$ref": "#/$defs/hash"
        },
        "output_format": {
          "enum": [
            "PNG",
            "JPEG",
            "TIFF"
          ]
        },
        "output_bit_depth": {
          "enum": [
            8,
            16
          ]
        },
        "encode_clipped_fraction": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    }
  }
}
