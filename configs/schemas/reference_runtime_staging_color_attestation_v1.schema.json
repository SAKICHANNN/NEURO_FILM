{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neuro-film.runtime-staging-color-attestation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "attestation_id",
    "policy_id",
    "decode_id",
    "consumption_id",
    "run_id",
    "expected_profile_sha256",
    "expected_profile_size_bytes",
    "source_count",
    "state",
    "path_consumption_authorized",
    "persistent_attestation_authorized",
    "application_authorized",
    "delivery_authorized",
    "outputs",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "neuro-film.runtime-staging-color-attestation.v1"
    },
    "attestation_id": {"$ref": "#/$defs/hash"},
    "policy_id": {
      "const": "neuro-film.exact-embedded-srgb-icc-no-conflict.v1"
    },
    "decode_id": {"$ref": "#/$defs/hash"},
    "consumption_id": {"$ref": "#/$defs/hash"},
    "run_id": {"$ref": "#/$defs/hash"},
    "expected_profile_sha256": {"$ref": "#/$defs/hash"},
    "expected_profile_size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "source_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "state": {
      "const": "attested-runtime-staging-embedded-srgb"
    },
    "path_consumption_authorized": {"const": false},
    "persistent_attestation_authorized": {"const": false},
    "application_authorized": {"const": false},
    "delivery_authorized": {"const": false},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/output"}
    },
    "claim_ceiling": {
      "const": "embedded-srgb-metadata-attested-for-process-local-bridge-only-no-persistence-application-or-delivery"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_index",
        "source_view_id",
        "output_view_id",
        "encoded_file_sha256",
        "output_format",
        "output_bit_depth",
        "profile_binding",
        "profile_sha256",
        "profile_size_bytes",
        "orientation",
        "metadata_attestation_id"
      ],
      "properties": {
        "source_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "source_view_id": {"$ref": "#/$defs/hash"},
        "output_view_id": {"$ref": "#/$defs/hash"},
        "encoded_file_sha256": {"$ref": "#/$defs/hash"},
        "output_format": {"enum": ["PNG", "JPEG", "TIFF"]},
        "output_bit_depth": {"enum": [8, 16]},
        "profile_binding": {
          "enum": [
            "png-iccp-exact-v1",
            "jpeg-app2-icc-exact-v1",
            "tiff-34675-icc-exact-v1"
          ]
        },
        "profile_sha256": {"$ref": "#/$defs/hash"},
        "profile_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "orientation": {"const": 1},
        "metadata_attestation_id": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {
          "if": {"properties": {"output_format": {"const": "PNG"}}},
          "then": {
            "properties": {
              "profile_binding": {"const": "png-iccp-exact-v1"}
            }
          }
        },
        {
          "if": {"properties": {"output_format": {"const": "JPEG"}}},
          "then": {
            "properties": {
              "output_bit_depth": {"const": 8},
              "profile_binding": {"const": "jpeg-app2-icc-exact-v1"}
            }
          }
        },
        {
          "if": {"properties": {"output_format": {"const": "TIFF"}}},
          "then": {
            "properties": {
              "profile_binding": {"const": "tiff-34675-icc-exact-v1"}
            }
          }
        }
      ]
    }
  }
}
