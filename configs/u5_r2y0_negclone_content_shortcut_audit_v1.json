  "method_scope": {
    "question": "does the published scan-aggregation fingerprint isolate stock evidence, or can content, exposure and texture alone determine its exported look parameters?",
    "minimum_images": 5,
    "default_sample_size": 20,
    "synthetic_probe_seed": 27070,
    "external_image_payloads_allowed": false,
    "network_allowed": false
  },
  "static_contract": {
    "required_true": [
      "unseeded_image_sampling",
      "unseeded_grain_patch_sampling",
      "within_image_percentile_colour_masks",
      "scene_histogram_tone_curve",
      "random_texture_grain_measurement",
      "median_aggregation_only",
      "scanner_offsets_declared_approximate",
      "preset_has_tone_colour_grain"
    ],
    "required_false": [
      "preset_has_3d_lut"
    ]
  },
  "gates": {
    "minimum_colour_bias_l2_shortcut": 0.5,
    "minimum_tone_curve_output_difference": 100.0,
    "maximum_flat_grain_intensity": 1e-12,
    "minimum_checker_grain_intensity": 0.2,
    "minimum_checker_clumping": 0.9,
    "repeat_report_sha256_equal": true
  },
  "branches": [
    "content_histogram_texture_shortcut_close",
    "source_or_probe_not_reproduced",
    "shortcut_not_demonstrated"
  ],
  "forbidden_actions": [
    "download Flickr or other community film pixels for this audit",
    "fit or generate a stock preset from current project pixels",
    "treat median aggregation as a nuisance-control method",
    "treat approximate scanner constants as calibrated measurements",
    "add a neural encoder or more photos as a rescue",
    "claim tone, color or texture differences identify a film stock"
  ],
  "claim_ceiling": "source-bound and synthetic counterfactual evidence about NegClone 0.2.0 fingerprint identifiability; no claim about every possible curated controlled use, no film or stock operator identification, and no real-image product evaluation"
}
