    "api_used": false,
    "api_key_required": false
  },
  "stocks": [
    {"film_code": "VELVI", "film_stock_id": "fujifilm_velvia_50", "description": "Fuji Velvia 50, NASA/JSC media code VELVI", "primary": true},
    {"film_code": "5775", "film_stock_id": "kodak_portra_400nc", "description": "Kodak Portra 400NC, NASA/JSC media code 5775", "primary": true},
    {"film_code": "5776", "film_stock_id": "kodak_portra_400vc", "description": "Kodak Portra 400VC, NASA/JSC media code 5776", "primary": false, "auxiliary_only": true}
  ],
  "query": {
    "method": "POST",
    "form_fields": {"mode": "db"},
    "one_exact_film_code_per_query": true,
    "maximum_post_requests": 3,
    "maximum_result_get_requests": 3,
    "maximum_total_requests": 6,
