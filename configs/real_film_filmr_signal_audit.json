  "candidate_features": {
    "colour_only": "Lab means/std/quantiles/chroma/hue occupancy from originals",
    "structure_only": "grayscale HOG/edge/entropy; no colour",
    "damage_only": "paired restoration change fractions and magnitude",
    "combined": "all frozen descriptors"
  },
  "stop_rules": [
    "missing content labels or evidence hash mismatch",
    "family-by-content support has structural zeros that prevent the frozen held-out comparison",
    "structure-only or damage-only equals/exceeds colour-only after grouped controls",
    "colour signal disappears under leave-one-content-category-out",
    "permutation-adjusted evidence is not significant"
  ],
  "claim_ceiling": "FILM-R filename-family exploratory signal only; never named-stock, roll, scanner-independent or calibrated truth"
