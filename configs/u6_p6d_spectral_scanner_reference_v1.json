          "weight": 0.75
        },
        {
          "center_nm": 545.0,
          "sigma_nm": 42.0,
          "weight": 1.0
        },
        {
          "center_nm": 625.0,
          "sigma_nm": 36.0,
          "weight": 0.82
        }
      ],
      "sensor_center_nm_rgb": [
        610.0,
        540.0,
        460.0
      ],
      "sensor_sigma_nm_rgb": [
        38.0,
        32.0,
        30.0
      ]
    },
    "scanner_b": {
      "profile_id": "synthetic-spectral-scanner-b-v1",
      "illuminant_components": [
        {
          "center_nm": 430.0,
          "sigma_nm": 22.0,
          "weight": 0.92
        },
        {
          "center_nm": 570.0,
          "sigma_nm": 55.0,
          "weight": 0.78
        },
        {
          "center_nm": 655.0,
