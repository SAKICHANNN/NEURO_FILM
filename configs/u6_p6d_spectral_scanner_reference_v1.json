        445.0
      ],
      "sensor_sigma_nm_rgb": [
        30.0,
        40.0,
        24.0
      ]
    }
  },
  "synthetic_witnesses": {
    "clear_transmittance": 1.0,
    "neutral_transmittance": 0.55,
    "metamer_perturbation_max_abs": 0.28,
    "density_wedge": [
      0.0,
      0.25,
      0.5,
      1.0,
      2.0,
      3.0,
      4.0
    ]
  },
  "automatic_gates": {
    "clear_response_max_abs_error": 1e-12,
    "neutral_channel_spread_max": 1e-12,
    "output_minimum": 0.0,
    "output_maximum": 1.0,
    "density_wedge_maximum_positive_step": 1e-12,
    "scanner_a_metamer_max_abs_difference": 1e-12,
    "scanner_b_metamer_l2_difference_min": 0.02,
    "rgb_only_irreducible_l2_error_min": 0.01,
    "scanner_profile_cross_response_max_abs_min": 0.01,
    "repeat_report_sha256_exact": true
  },
  "negative_controls": [
    "identical spectral transmittance must produce identical output",
    "clear and neutral spectra must remain scanner-normalized",
    "a metamer pair for scanner A must not be called physically identical",
    "scanner B separation must disappear when scanner B is replaced by scanner A"
  ],
  "forbidden_fallbacks": [
    "fit or retune P6A RGB matrices against the synthetic witnesses",
    "call synthetic Gaussian spectra measured scanner profiles",
    "assign scanner profiles to film_stock_id or latent mode",
    "clip spectral or scanner signals",
    "open photographs, product integration or calibration claims"
  ],
  "branch_rule": {
    "pass": "retain an offline spectral scanner reference and quantify the approximation gap before any compiler experiment",
    "fail": "close the synthetic spectral witness or repair a numerical defect only; preserve P6A-C"
  },
  "research_basis": [
    {
      "source": "FADGI Technical Guidelines for Digitizing Cultural Heritage Materials, third edition",
      "url": "https://www.digitizationguidelines.gov/guidelines/FADGITechnicalGuidelinesforDigitizingCulturalHeritageMaterials_ThirdEdition_05092023.pdf",
      "use": "film capture colour depends on the acquisition system and profiling cannot restore information lost during capture"
    },
    {
      "source": "Characterization of Scanner Sensitivity",
      "url": "https://library.imaging.org/cic/articles/1/1/art00026",
      "use": "scanner colour characterization depends on illuminant and spectral sensitivity"
    },
    {
      "source": "ISO 21550:2004",
      "url": "https://www.iso.org/standard/35939.html",
      "use": "dynamic range evidence applies separately to transmissive scanners and does not identify spectral colour response"
    }
  ]
}
