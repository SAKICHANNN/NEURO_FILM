{
  "schema": "neuro_film.u6_p6d_spectral_scanner_reference_contract.v1",
  "node": "U6.P6D",
  "claim_ceiling": "generic-synthetic-spectral-scanner-reference-only",
  "parent_boundary": {
    "p6a_decision_path": "configs/u6_p6a_scanner_profile_decision_v1.json",
    "p6a_rgb_spectral_stage_is_approximation": true,
    "p6c_standard_compiler_unchanged": true
  },
  "domain_contract": {
    "input": "spectral-film-transmittance",
    "output": "relative-scanner-linear-signal",
    "arithmetic": "float64",
    "clear_film_normalization": true,
    "hard_clip_forbidden": true,
    "scanner_profile_stock_identity_forbidden": true
  },
  "wavelength_grid_nm": {
    "start": 400.0,
    "stop": 700.0,
    "step": 10.0
  },
  "synthetic_profiles": {
    "scanner_a": {
      "profile_id": "synthetic-spectral-scanner-a-v1",
      "illuminant_components": [
        {
          "center_nm": 445.0,
